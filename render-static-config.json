  "headers": [
    {
      "path": "/*",
      "name": "X-Frame-Options",
      "value": "DENY"
    },
    {
      "path": "/*",
      "name": "X-Content-Type-Options",
      "value": "nosniff"
    },
    {
      "path": "/*",
      "name": "Referrer-Policy",
      "value": "strict-origin-when-cross-origin"
    },
    {
      "path": "/*",
      "name": "Permissions-Policy",
      "value": "camera=(), microphone=(), geolocation=(self)"
    },
    {
      "path": "/*",
      "name": "Strict-Transport-Security",
      "value": "max-age=31536000"
    },
    {
      "path": "/*",
      "name": "X-Permitted-Cross-Domain-Policies",
      "value": "none"
    },
    {
      "path": "/*",
      "name": "Content-Security-Policy",
      "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' https: data: https://maps.google.com https://maps.gstatic.com https://maps.googleapis.com https://*.googleapis.com https://*.ggpht.com; connect-src 'self' https://afghaneats-api.onrender.com https://maps.googleapis.com https://places.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
    },
    {
      "path": "/*.html",
      "name": "Cache-Control",
      "value": "no-cache, max-age=0, must-revalidate"
    },
    {
      "path": "/config.js",
      "name": "Cache-Control",
      "value": "no-cache, max-age=0, must-revalidate"
    },
    {
